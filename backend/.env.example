# StockSense AI backend configuration.
# Every value below is optional: the defaults in config.py already run the app.
# Copy this file to `.env` only if you need to override something.

# Default symbol and history used when a request omits them.
STOCKSENSE_DEFAULT_TICKER=RELIANCE.NS
STOCKSENSE_DEFAULT_PERIOD=2y

# Absolute or relative SQLite path. The default lives in backend/data/.
# STOCKSENSE_DATABASE_URL=sqlite:///./data/stocksense.db

# Price cache TTL (seconds) and quote-metadata cache TTL (seconds).
STOCKSENSE_CACHE_TTL_SECONDS=600
STOCKSENSE_INFO_CACHE_TTL_SECONDS=86400

# Browser origins allowed to call the API.
STOCKSENSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Outbound request timeout budget in seconds.
STOCKSENSE_REQUEST_TIMEOUT_SECONDS=25

# Optional free API keys. No feature requires them; the platform runs on
# Yahoo Finance (yfinance) with no key at all. Reserved for future providers.
STOCKSENSE_ALPHA_VANTAGE_API_KEY=
STOCKSENSE_FINNHUB_API_KEY=
